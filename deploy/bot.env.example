# Copy to /etc/ctrader-smc-bot/bot.env and chmod 600.
CTRADER_CLIENT_ID=replace_me
CTRADER_CLIENT_SECRET=replace_me
CTRADER_REDIRECT_URI=https://replace-me.example/api/callback
CTRADER_TOKEN_URI=https://connect-proto.ctrader.com/apps/token
CTRADER_ACCOUNT_ID=replace_me
MONGO_URI=mongodb://127.0.0.1:27017/ctrader_db
CTRADER_LIVE_STATUS=false
CTRADER_SYMBOL_ID=41
CTRADER_EQUITY=10000
SMC_CONFIG_PATH=config/smc_strategy.json
SMC_HISTORY_DAYS=30
LOG_LEVEL=INFO
